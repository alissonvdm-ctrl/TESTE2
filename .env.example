# Application
APP_NAME=NumericSequenceAnalyzer
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-strong-random-key

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
WORKERS=4

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sequence_analyzer
POSTGRES_USER=analyst
POSTGRES_PASSWORD=analyst_password
DATABASE_URL=postgresql+asyncpg://analyst:analyst_password@postgres:5432/sequence_analyzer
SYNC_DATABASE_URL=postgresql://analyst:analyst_password@postgres:5432/sequence_analyzer

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# File storage
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=100

# ML settings
MAX_TRAINING_TIME_SECONDS=3600
DEFAULT_CV_SPLITS=5
RANDOM_SEED=42

# MLflow (optional)
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=sequence_analyzer

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# GPU (optional)
USE_GPU=false
CUDA_VISIBLE_DEVICES=0
